{
  "name": "techhub-ecommerce",
  "version": "1.0.0",
  "description": "MERN E-commerce Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"cmd.exe /c npm run server\" \"cmd.exe /c npm run client\"",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.8.9"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "mern",
    "react",
    "node",
    "mongodb",
    "ecommerce"
  ],
  "author": "TechHub Team",
  "license": "MIT"
}
